{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "arac": {
      "command": [
        "arac",
        "serve",
        "--tool-profile",
        "all"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "aracne_*": "deny",
    "aracne_bug_report": "allow",
    "aracne_edit": "allow",
    "aracne_grep": "allow",
    "aracne_read": "allow",
    "aracne_read_dependency": "allow",
    "aracne_read_file": "allow",
    "aracne_read_function": "allow",
    "aracne_read_interface": "allow",
    "aracne_read_named_type": "allow",
    "aracne_read_package": "allow",
    "aracne_read_struct": "allow",
    "aracne_warnings_list": "allow",
    "aracne_write": "allow",
    "edit": "deny",
    "read": "deny"
  }
}
