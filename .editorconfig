root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{py,md}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# A deliberately malformed corpus. Editors must leave it exactly as written --
# reformatting shifts line numbers the at-scale suites assert on.
[testing_ground/**]
trim_trailing_whitespace = false
insert_final_newline = false
