# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
node_modules/
dist/
build/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Logs, local databases, secrets
*.log
*.db
.env

# Aracne's own per-project state, written into whatever repo it scans
.aracne/

# Editor / harness state. `arac init` regenerates both from .aracne/config.json.
.claude/
.opencode/
.rtk/

# Internal defect registers and audit reports. Kept locally, never published:
# they are working notes about this repo's own bugs, not documentation.
docs/audits/
bin/
